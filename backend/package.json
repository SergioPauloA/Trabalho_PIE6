{
  "name": "supervalidade-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "node scripts/clean-build.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "test:http": "node scripts/smoke-http.mjs",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "etl": "tsx src/etl/cli.ts",
    "docs:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^6.1.2",
    "@prisma/client": "7.10.1",
    "@prisma/adapter-pg": "7.10.1",
    "dotenv": "^17.2.3",
    "fastify": "^5.6.1",
    "fastify-type-provider-zod": "^6.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^22.18.12",
    "prisma": "7.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
